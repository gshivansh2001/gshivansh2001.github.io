@unpublished{gupta_ai_disclosure,
  title     = {Examining Effects of AI Disclosure on Early-Stage Ventures},
  author    = {Sharma, Vasundhara and Barua, Anitesh and Agarwal, Ashish and Gayatri, Aketi and Gupta, Shivansh},
  year      = {2026},
  note      = {Work in progress},
  abstract =  {Draft in preparation. This paper studies how transparency about artificial intelligence reshapes market behavior in creative funding contexts. Using a platform-level policy change as a source of exogenous variation, we show that mandatory AI disclosure leads to significant declines in funding outcomes. We argue that disclosure activates a multi-channel devaluation process, wherein perceptions of reduced human effort, diminished authenticity, and heightened skepticism jointly suppress support. By linking causal estimates with discourse-based evidence, the study highlights how transparency can trigger adverse belief formation in environments where value is closely tied to human authorship.},
  selected  = {true}
}

