@misc{gupta_hidden_ads_kids,
  title     = {Curbing Hidden Advertisements in Children's Videos: The Limits of Platform Policies},
  author    = {Sharma, Vasundhara and Kumar, Sumeet and Agarwal, Ashish},
  year      = {2025},
  abstract  = {[Best Paper Runner Up at Platform Strategy Conference (Boston University), 2026] Digital platforms have become central intermediaries in children’s media consumption, yet their capacity to self-regulate in the interest of child welfare remains unclear. This question has acquired particular urgency as jurisdictions worldwide implement regulatory interventions, from Australia’s 2024 ban on social media for minors under 16 to over 300 pending U.S. state bills and the EU Digital Services Act mandates for child safety. We provide evidence on platform self-regulation by examining YouTube’s 2021 policy prohibiting promotional content in children’s videos, an intervention on the world’s most widely used video platform among children. Many of these videos embed hidden advertisements, a concerning phenomenon currently under Federal Trade Commission investigation, because young viewers struggle to discern advertisements from organic content. Using data from over 200 channels and a large language model to identify hidden advertisements at scale, we implement a synthetic difference-in-differences design. We find a modest reduction in advertising content, driven by independent creators, while brand-affiliated creators maintain advertising intensity and reduce disclosure. More concerningly, overall sponsorship disclosure declines by approximately 13 percent, indicating that creators render commercial content less transparent rather than eliminating it. These results demonstrate that YouTube’s self-regulatory intervention generated perverse outcomes that undermined transparency while leaving advertising intensity largely intact, underscoring the limits of platform self-governance in protecting vulnerable children.},
  note      = {Research assistance}
}

@misc{gupta_misinformation_platform,
  title     = {Platform Design to Curb Misinformation},
  author    = {Sharma, Vasundhara and Barua, Anitesh and Agarwal, Ashish},
  year      = {2025},
  abstract = {We propose and test a crowd-based content moderation approach to combat the spread of misinformation. In this method, users can flag posts they believe contain misinformation, with such flags serving as visible cues to others. These cues then influence users' moderation and sharing decisions. We assess users' willingness to participate in moderation and identify the underlying drivers. Thereafter, we examine whether such flags can address two primary causes for the spread of misinformation -lack of knowledge and scrutiny, specifically when posts align with one's ideology. We developed a social media application and conducted a randomized controlled experiment. Participants were shown both true and false posts about politics, COVID-19, and the Russia-Ukraine conflict, along with social cues like flags and share counts. Our results demonstrate that users with a higher level of knowledge are more likely to flag misinformation and that their flags are not influenced by their personal beliefs. The presence of these flags encourages other users, especially those with less information, to be more cautious about sharing content. The presence of flags also reduces the spread of misinformation, even when users' beliefs align with false posts. We also establish that users' flagging and sharing behavior are driven by their updated opinions regarding the accuracy of the post and the need for impression management. Our study reveals a key limitation in the current approach to platform moderation, where user feedback is not made visible to others. It demonstrates that a crowd-based approach can be effective in curbing misinformation.},
  note      = {Research assistance}
}

